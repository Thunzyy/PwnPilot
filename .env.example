# PwnPilot local startup configuration
# Copy to `.env` and adjust as needed.

# Shared bind addresses
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1

# Local dev ports
# 8001 avoids common collisions with Tomcat / other local services on Windows.
BACKEND_PORT=8001
FRONTEND_PORT=5173

# Optional explicit URLs. Leave commented to derive from BACKEND_HOST/BACKEND_PORT.
# BACKEND_URL=http://127.0.0.1:8001
# API_BASE_URL=http://127.0.0.1:8001/api/v1
# VITE_API_URL=http://127.0.0.1:8001

# Runtime defaults
DEBUG=false
AUTO_STOP_PORT_LISTENERS=false
ATTACK_GRAPH_AUTO_SEED_DEMO=true
SEED_ADMIN_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PROJECT_NAME="CTF Demo Admin"
SEED_ADMIN_PROJECT_TYPE=ctf

# Platform-specific terminal providers
WINDOWS_CONSOLE_PROVIDER=legacy
LINUX_CONSOLE_PROVIDER=tmux_ttyd

# Optional workspace override
PROJECTS_ROOT=~/PwnPilot/projects
